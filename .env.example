NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only; never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Supabase CLI OAuth configuration: put these in the ignored root .env file.
# The CLI does not load .env.local. Never use NEXT_PUBLIC_ for the secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional, evaluation labeling (eval:label, eval:crosslingual). Defaults to local MTPLX
# at http://127.0.0.1:8888/v1 with the served model; an https URL requires LLM_API_KEY.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BATCH_SIZE=
