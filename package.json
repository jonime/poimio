{
  "name": "poimio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.mts",
    "enrich:backfill": "node scripts/enrich-backfill.mts",
    "embeddings:means": "node --env-file-if-exists=.env.local scripts/compute-embedding-language-means.mts",
    "ranking:freeze": "node --env-file-if-exists=.env.local scripts/freeze-ranking-sample.mts",
    "ranking:export": "node --env-file-if-exists=.env.local scripts/export-ranking-judging.mts",
    "ranking:score": "node scripts/score-ranking-judging.mts",
    "ranking:export:centered": "node --env-file-if-exists=.env.local scripts/export-centered-ranking.mts",
    "ranking:score:centered": "node scripts/score-centered-ranking.mts",
    "eval:export": "node --env-file=.env.production.local scripts/export-evaluation-snapshot.mts",
    "eval:import": "node --env-file=.env.local scripts/import-evaluation-snapshot.mts",
    "eval:label": "node --env-file-if-exists=.env.local scripts/label-evaluation-items.mts",
    "eval:agreement": "node scripts/evaluation-agreement.mts",
    "eval:judge": "node scripts/judge-csv.mts",
    "eval:crosslingual": "node --env-file-if-exists=.env.local scripts/evaluation-crosslingual.mts",
    "eval:replay": "node --env-file=.env.local scripts/evaluation-replay.mts",
    "eval:freeze": "node scripts/freeze-evaluation.mts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/schedules": "^0.0.3",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.14.0"
}
